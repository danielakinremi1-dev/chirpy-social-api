# Requests for the VS Code REST Client extension.
# Run "Create user" and "Login" first; later requests reuse the tokens
# from the login response. The webhook key is read from POLKA_KEY in .env.

@baseUrl = http://localhost:8080
@email = user@example.com
@password = change-me-123
@apiKey = {{$dotenv POLKA_KEY}}
@token = {{login.response.body.$.token}}
@refreshToken = {{login.response.body.$.refresh_token}}
@userId = {{login.response.body.$.id}}
@chirpId = {{createChirp.response.body.$.id}}

### Create user
POST {{baseUrl}}/api/users
Content-Type: application/json

{
    "email": "{{email}}",
    "password": "{{password}}"
}

### Login
# @name login
POST {{baseUrl}}/api/login
Content-Type: application/json

{
    "email": "{{email}}",
    "password": "{{password}}"
}

### Update user
PUT {{baseUrl}}/api/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "email": "{{email}}",
    "password": "{{password}}"
}

### Create chirp
# @name createChirp
POST {{baseUrl}}/api/chirps
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "body": "hello"
}

### List chirps
GET {{baseUrl}}/api/chirps

### List chirps, ascending
GET {{baseUrl}}/api/chirps?sort=asc

### List chirps by author
GET {{baseUrl}}/api/chirps?author_id={{userId}}

### Get chirp
GET {{baseUrl}}/api/chirps/{{chirpId}}

### Delete chirp
DELETE {{baseUrl}}/api/chirps/{{chirpId}}
Authorization: Bearer {{token}}

### Refresh access token
POST {{baseUrl}}/api/refresh
Authorization: Bearer {{refreshToken}}

### Revoke refresh token
POST {{baseUrl}}/api/revoke
Authorization: Bearer {{refreshToken}}

### Polka webhook: upgrade user
POST {{baseUrl}}/api/polka/webhooks
Content-Type: application/json
Authorization: ApiKey {{apiKey}}

{
  "event": "user.upgraded",
  "data": {
    "user_id": "{{userId}}"
  }
}

### Admin metrics
GET {{baseUrl}}/admin/metrics

### Static app
GET {{baseUrl}}/app/

### Admin reset (dev only)
POST {{baseUrl}}/admin/reset
