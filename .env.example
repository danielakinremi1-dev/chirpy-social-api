# Copy to .env for running locally with `make run`.
# `docker compose up` doesn't need this file.

# Local Postgres connection string.
DB_URL="postgres://postgres:postgres@localhost:5432/chirpy?sslmode=disable"

# "dev" enables POST /admin/reset. Leave empty in production; the server
# refuses to start with "dev" on Render.
PLATFORM="dev"

# JWT signing secret. Generate one with: openssl rand -base64 64
SECRET=""

# API key the Polka payment webhook sends.
POLKA_KEY=""

# Optional.
PORT=8080
MIGRATE_ON_START=false

# The number of reverse proxies in front of the server that append to
# X-Forwarded-For (3 on Render). Leave it off when clients connect directly,
# or they could pick their own IP.
TRUST_PROXY=false
